{
  "name": "meetcall-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"blue,magenta\" \"pnpm --filter @meetcall/api start:dev\" \"pnpm --filter @meetcall/web dev\"",
    "build": "pnpm --filter @meetcall/shared build && pnpm --filter @meetcall/api build && pnpm --filter @meetcall/web build",
    "lint": "pnpm --recursive run lint",
    "test": "pnpm --filter @meetcall/api test && pnpm --filter @meetcall/api test:e2e",
    "test:e2e": "pnpm --filter @meetcall/api test:e2e",
    "typecheck": "pnpm --filter @meetcall/shared typecheck && pnpm --filter @meetcall/api exec tsc --noEmit && pnpm --filter @meetcall/web exec tsc -b",
    "db:migrate": "pnpm --filter @meetcall/api prisma migrate dev",
    "db:deploy": "pnpm --filter @meetcall/api prisma migrate deploy",
    "db:generate": "pnpm --filter @meetcall/api prisma generate",
    "db:seed": "pnpm --filter @meetcall/api prisma db seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.21.0",
    "prettier": "^3.5.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma",
      "sharp",
      "msgpackr-extract"
    ]
  }
}
