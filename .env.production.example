# MeetCall Production Environment Variables Example
# Sao chép tệp này thành .env.production trên máy chủ và điền các giá trị thực tế

# Domain & SSL Caddy
DOMAIN=meetcall.yourdomain.com
ACME_EMAIL=admin@yourdomain.com

# PostgreSQL & PostGIS
POSTGRES_USER=meetcall
POSTGRES_PASSWORD=generate_a_very_strong_password_here_min_32_chars
POSTGRES_DB=meetcall

# Redis Cache & Queue
REDIS_PASSWORD=generate_a_very_strong_redis_password_here_min_32_chars

# Authentication & Security Keys (Tối thiểu 32 ký tự ngẫu nhiên)
JWT_SECRET=generate_super_secret_jwt_key_at_least_32_characters_long
AGE_VERIFICATION_SECRET=generate_strong_kyc_webhook_secret_here

# STUN / TURN WebRTC Server (RFC 5766)
TURN_HOST=turn.yourdomain.com
TURN_SECRET=generate_strong_coturn_auth_secret_here

# Email SMTP (Gửi OTP, Reset mật khẩu qua Resend/SendGrid/SES)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
SMTP_FROM=MeetCall <no-reply@yourdomain.com>

# Cloudflare R2 / AWS S3 Storage (Kiểm duyệt & lưu trữ ảnh)
STORAGE_DRIVER=s3
S3_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=meetcall-photos-prod
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_PUBLIC_DOMAIN=https://cdn.yourdomain.com
